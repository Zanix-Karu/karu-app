{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@karu/api",
        "start:dev"
      ],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@karu/web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "api-3011",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_PORT=3011",
        "PORT=3011",
        "CORS_ORIGIN=http://localhost:5174",
        "pnpm",
        "--filter",
        "@karu/api",
        "start:dev"
      ],
      "port": 3011
    },
    {
      "name": "web-api-3011",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_URL=http://localhost:3011",
        "pnpm",
        "--filter",
        "@karu/web",
        "dev",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
