# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Service-role key — SERVER ONLY. The NestJS API uses this to bypass RLS.
# NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret used to verify Supabase-issued access tokens locally in the API.
# Supabase Dashboard → Project Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Optional in dev: without a key, emails are recorded as 'failed' in email_log
# and booking operations continue unaffected.
RESEND_API_KEY=
EMAIL_FROM="Karu <bookings@karuapp.com>"
# Booking messages are relayed here (default: support@getkaru.io).
SUPPORT_EMAIL=

# ── Card deposits (Stripe) ──────────────────────────────────────────────────
# Optional: set BOTH to turn on real card deposits via Stripe Checkout, or
# NEITHER for the manual placeholder (the API refuses to boot with only one —
# charging without the webhook would take money it never marks received).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe Checkout returns the customer (falls back to first CORS_ORIGIN).
WEB_APP_URL=http://localhost:5173

# ── API (NestJS) ────────────────────────────────────────────────────────────
API_PORT=3000
# Comma-separated origins allowed by CORS (the web app's URL).
CORS_ORIGIN=http://localhost:5173

# ── Web (Vite) — only VITE_* vars reach the browser ─────────────────────────
VITE_API_URL=http://localhost:3000
# Public Supabase creds for the browser SDK (auth/login only — anon key is safe
# to ship; it is gated by RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Currency display ────────────────────────────────────────────────────────
# XAF↔EUR is a FIXED peg (655.957) so euro conversion is exact and needs no
# config. GBP floats, so supply a rate if you want sterling shown; without it
# a conservative fallback is used and every GBP figure is marked approximate.
VITE_XAF_PER_GBP=
