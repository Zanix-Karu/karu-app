<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static entry points only. Car and provider pages are rendered client-side
  from the API, so they cannot be enumerated at build time — indexing those
  needs prerendering or SSR (SEO-1). Listing the stable routes is still worth
  more than serving the SPA shell for /sitemap.xml, which is what happened
  before this file existed.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://app.getkaru.io/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://app.getkaru.io/search</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://app.getkaru.io/vendors</loc>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://app.getkaru.io/list-your-car</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
</urlset>
